    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "Доля ответов Attack без UNAVAILABLE/INTERNAL/DEADLINE_EXCEEDED; RESOURCE_EXHAUSTED не учитывается. Recording rule из deploy/alerts/slo.yml.",
      "id": 100,
      "title": "SLO: Attack без сбоя (1 ч, цель 99,9%)",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "1 - raidboss:attack_error_ratio:rate1h",
          "instant": false,
          "range": true,
          "refId": "A",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "Какая доля бюджета ошибок SLO 99,9% за 28 дней ещё не израсходована. Ниже нуля — SLO нарушен.",
      "id": 101,
      "title": "Бюджет ошибок Attack: остаток (28 дн)",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0
              },
              {
                "color": "green",
                "value": 0.25
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "1 - ((sum(increase(rpc_server_call_duration_seconds_count{rpc_method=\"raidboss.v1.RaidService/Attack\",rpc_response_status_code=~\"(?i)unavailable|internal|deadline_exceeded|unknown|data_loss\"}[28d])) or vector(0)) / sum(increase(rpc_server_call_duration_seconds_count{rpc_method=\"raidboss.v1.RaidService/Attack\",rpc_response_status_code!~\"(?i)resource_exhausted\"}[28d]))) / 0.001",
          "instant": false,
          "range": true,
          "refId": "A",
          "legendFormat": "__auto"
        }
      ]
    },
